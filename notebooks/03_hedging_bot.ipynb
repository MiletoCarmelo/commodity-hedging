    "source = SimulatedSource(start, end, calendar, seed=2)\n",
    "settings = load_hedge_settings(\"../config/hedging.yaml\")   # model, costs, allowed futures\n",
    "run = HedgingBot(book, source, settings).run()\n",
    "df = run.to_frame()\n",
    "df.index = pd.to_datetime(df.index)\n",
    "months = {\"Jan\": (\"2027-01-01\", \"2027-01-31\"), \"Apr\": (\"2027-04-01\", \"2027-04-30\"),\n",
    "          \"Jun\": (\"2027-06-01\", \"2027-06-30\")}\n",
    "\n",
    "def shade(ax):\n",
    "    for a, b in months.values():\n",
    "        ax.axvspan(pd.Timestamp(a), pd.Timestamp(b), color=MUTED, alpha=0.08, linewidth=0)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(9, 4.5))\n",
    "for u, color in zip((\"HO\", \"BRENT\", \"WTI\"), SERIES):\n",
    "    ax.plot(df.index, df[f\"F_{u}\"], color=color, label=u)\n",
    "shade(ax)\n",
    "price_axis_right(ax)\n",
    "ax.set(ylabel=\"$/bbl\")\n",
    "titles(ax, \"Simulated futures\", \"one correlated GBM path, shaded: the three pricing months\")\n",
    "ax.legend(loc=\"upper center\", bbox_to_anchor=(0.5, -0.12), ncol=4, frameon=False)\n",
    "plt.show()"
   ]
