   "source": [
    "book = load_portfolio(\"../portfolios/example_book.yaml\")\n",
    "\n",
    "start = MarketData(\n",
    "    today=ql.Date(10, 11, 2026), rate=0.04,\n",
    "    quotes={\"HO\": Quote(105.0, 0.30), \"BRENT\": Quote(75.0, 0.32), \"WTI\": Quote(71.0, 0.33)},\n",
    "    correlations={(\"HO\", \"BRENT\"): 0.95, (\"WTI\", \"BRENT\"): 0.97, (\"HO\", \"WTI\"): 0.93},\n",
    ")\n",
    "calendar = any_exchange_calendar([\"NYMEX\", \"ICE-EU\"])\n",
    "\n",
    "# horizon\n",
    "end = ql.Date(15, 7, 2027)\n",
    "\n",
    "pricer = Pricer(market=start)\n",
    "pd.DataFrame({\n",
    "    t.id: {\"PV $\": t.instrument.quantity * pricer.pv(t.instrument),\n",
    "           **{f\"delta {u} bbl\": t.instrument.quantity * d\n",
    "              for u, d in pricer.deltas(t.instrument).items()}}\n",
    "    for t in book\n",
    "}).T.fillna(0).round(0)"
   ]
  },
