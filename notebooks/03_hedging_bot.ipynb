   "source": [
    "crack = Portfolio(name=\"crack\", trades=[book.trade(\"APO-003\")])\n",
    "implied = {u: start.vol(u) for u in start.quotes}\n",
    "free = HedgeSettings(cost_per_lot=0, explain=False)\n",
    "\n",
    "def total_pnls(scale, seeds=range(40), settings=free):\n",
    "    out = []\n",
    "    for seed in seeds:\n",
    "        vols = {u: v * scale for u, v in implied.items()}\n",
    "        src = SimulatedSource(start, end, calendar, realized_vol=vols, seed=seed)\n",
    "        out.append(HedgingBot(crack, src, settings).run().total_pnl)\n",
    "    return np.array(out)\n",
    "\n",
    "scales = [0.6, 1.0, 1.4]\n",
    "results = {s: total_pnls(s) for s in scales}\n",
    "pd.DataFrame({f\"realised = {s:.0%} of implied\": [r.mean(), r.std()]\n",
    "              for s, r in results.items()}, index=[\"mean $\", \"std $\"]).round(0)"
   ]
  },
