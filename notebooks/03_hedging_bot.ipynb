    "from cmdty.hedging import HedgeSettings, HedgingBot, daily_report, ladder, load_hedge_settings\n",
    "from cmdty.risk import book_risk\n",
    "from cmdty.market import SimulatedSource, any_exchange_calendar\n",
    "from cmdty.plotting import MUTED, SERIES, TEXT, area_line, last_value, price_axis_right, ref_line, titles, use_style\n",
    "\n",
    "use_style()\n",
    "# deep in the money late in the month Kirk hands over to Bachelier, already tested\n",
    "import warnings\n",
    "warnings.filterwarnings(\"ignore\", message=\"Kirk undefined\")"
   ]
